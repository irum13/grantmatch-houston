# Optional AI extraction. A conservative local fallback works without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Supabase opportunity database. Bundled curated data is the fallback.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google OAuth for real-user Drive, Gmail, and Calendar actions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use a long random value; tokens are encrypted before entering cookies.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Dedicated project-owned sandbox account. Never use a personal account.
GOOGLE_DEMO_CLIENT_ID=
GOOGLE_DEMO_CLIENT_SECRET=
GOOGLE_DEMO_REFRESH_TOKEN=
